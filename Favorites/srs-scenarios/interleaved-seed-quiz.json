      "type": "favorite",
      "wordBank": "en-fr-common",
      "count": 10,
      "onlyNew": true
    },
    { "type": "delay", "ms": 500 },
    {
      "type": "play",
      "games": 1,
      "sourceStrategy": "FAVOURITES",
      "learningStrategy": "SRS",
      "nbTerms": 7,
      "correctRatio": 0.75
    },

