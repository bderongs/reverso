{
  "id": "interleaved-seed-quiz",
  "name": "Interleaved seed + quiz waves",
  "description": "Start with ~10 new favourites, play 1 SRS quiz, then keep alternating small random seed batches (2–5) with single quizzes — 10 waves total. Stresses pool growth, mix, and delta corpus refresh between games.",
  "defaults": {
    "sourceLang": "en",
    "targetLang": "fr",
    "delayMs": 250,
    "source": 0
  },
  "steps": [
